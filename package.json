{
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@gingacodemonkey/config": "^0.0.38",
    "@types/node": "^24.12.4",
    "@varlock/bumpy": "^1.18.1",
    "eslint": "^9.39.5",
    "husky": "9.1.7",
    "jiti": "^2.7.0",
    "jscpd": "^5.0.12",
    "knip": "6.26.0",
    "lint-staged": "17.0.8",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "bump": "bumpy add",
    "bump:status": "bumpy status",
    "release": "pnpm --filter prisma-ts-select build && pnpm install --frozen-lockfile && pnpm -r gen && pnpm --filter prisma-ts-select test && bumpy publish",
    "test:all": "node packages/run-tests-tui/src/index.ts --coverage --reset-db",
    "test:v6": "pnpm test:all --version 6",
    "test:v7": "pnpm test:all --version 7",
    "test:sqlite": "pnpm test:all --db sqlite",
    "test:sqlite:v6": "pnpm test:sqlite --version 6",
    "test:sqlite:v7": "pnpm test:sqlite --version 7",
    "test:mysql": "pnpm test:all --db mysql",
    "test:mysql:v6": "pnpm test:mysql --version 6",
    "test:mysql:v7": "pnpm test:mysql --version 7",
    "test:pg": "pnpm test:all --db pg",
    "test:pg:v6": "pnpm test:pg --version 6",
    "test:pg:v7": "pnpm test:pg --version 7",
    "lint:ts": "pnpm -r --no-bail lint:ts",
    "lint:esl": "pnpm -r --no-bail lint:esl",
    "lint:esl:fix": "pnpm -r --no-bail lint:esl:fix",
    "lint:s": "pnpm -r --no-bail lint:s",
    "lint:fix": "pnpm -r --no-bail lint:fix",
    "lint:knip": "knip",
    "lint:jscpd": "pnpm -r --no-bail lint:jscpd",
    "lint": "pnpm lint:ts && pnpm lint:s",
    "lint:e18e": "pnpm dlx @e18e/cli analyze",
    "test:coverage": "pnpm -r run test:coverage",
    "test:full": "pnpm --filter prisma-ts-select test && pnpm test:all"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "better-sqlite3",
      "es5-ext",
      "esbuild",
      "prisma",
      "puppeteer",
      "unrs-resolver"
    ]
  },
  "version": "0.0.1-rc.1",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
